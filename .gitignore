# ── 按需排除的文件夹 ──
# 设计文档（含金样例 SRD 原始档案，不入库）
docs/
# 运行期产物（代码会自动创建 output/runs 等目录树）
output/
# 渲染临时产物
_tmp_render/

# ── 本地工具状态（非项目代码） ──
.codeartsdoer/
.workbuddy/

# ── 向量库备份垃圾 ──
vectors/*.bak*
vectors/*.bak-*
vectors/*.bak2-*
vectors/*.bak3-*

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ── IDE / 系统 ──
.idea/
.vscode/
Thumbs.db
Desktop.ini
